{
  "name": "rentflow",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
    "scripts": {
        "format": "prettier --write .",
        "start": "cd dist && bun run index.js",
        "build": "bun run build:backend && bun run build:frontend",
        "build:backend": "cd backend && bun run build",
        "build:frontend": "cd frontend && bun run build"
    }
}
